{
  "name": "@tacoherd/openinsights",
  "version": "5.0.0",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": "git@github.com:cbsinteractive/openinsights.git",
  "license": "MIT",
  "scripts": {
    "build": "tsc --build",
    "build:doc": "rimraf doc && typedoc src/index.ts",
    "lint": "tsc && eslint --fix 'src/**'",
