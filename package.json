{
  "name": "@tacoherd/openinsights",
  "version": "5.0.3",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": "git@github.com:cbsinteractive/openinsights.git",
  "license": "MIT",
  "scripts": {
    "build": "tsc --build",
    "build:doc": "rimraf doc && typedoc src/index.ts",
    "build:release": "rimraf dist && rollup -c",
    "lint": "tsc --noEmit && eslint --fix 'src/**'",
    "lint-check-only": "tsc --noEmit && eslint 'src/**'",
    "test": "jest --coverage",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "prepublishOnly": "npm run build:release"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.1.0",
    "@rollup/plugin-terser": "^0.4.3",
    "@rollup/plugin-typescript": "^11.1.2",
    "@types/jest": "^29.0.3",
    "@typescript-eslint/eslint-plugin": "^6.1.0",
    "@typescript-eslint/parser": "^6.1.0",
    "eslint": "^8.23.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.0.3",
    "jest-environment-jsdom": "^29.0.3",
    "prettier": "^3.0.0",
    "prettier-plugin-organize-imports": "^3.0.3",
    "rimraf": "^5.0.1",
    "rollup": "^3.26.3",
    "rollup-plugin-license": "^3.7.1",
    "rollup-plugin-sizes": "^1.0.3",
    "ts-jest": "^29.0.1",
    "tslib": "^2.4.0",
    "typedoc": "^0.24.8",
    "typescript": "^5.1.6"
  },
  "engines": {
    "node": ">=16"
  }
}
